# --- название клуба ---
# Подставляется в шапку, заголовки страниц и вкладку браузера.
APP_NAME=Алгоритмы ФИИ МГУ
APP_SHORT_NAME=Алгоритмы

# --- обязательное ---
SECRET_KEY=поменяй-меня-на-случайную-строку
BASE_URL=http://localhost:8000

# --- Telegram ---
# Токен от @BotFather. Без него вход через Telegram не работает.
TELEGRAM_BOT_TOKEN=
# Username бота без @ — нужен для построения ссылки t.me/<username>?start=<код>
TELEGRAM_BOT_USERNAME=

# Необязательно: общий чат клуба. Если он задан, объявления и задания уходят
# туда одним сообщением; если пусто — бот пишет каждому участнику лично.
# Чтобы узнать id, добавь бота в чат и отправь там /id.
TELEGRAM_NOTIFY_CHAT_ID=
# За сколько минут до старта события напоминать.
REMINDER_MINUTES_BEFORE=60
# За сколько часов до дедлайна задания напомнить тем, кто не закрыл.
ASSIGNMENT_REMINDER_HOURS=24

# Кому выдать роль преподавателя — telegram id через запятую.
# Свой id узнаешь, отправив боту /id. Проверяется при каждом входе.
TEACHER_TELEGRAM_IDS=

# --- вход через OpenID Connect (Authentik) ---
# Issuer берётся из настроек провайдера в Authentik: Applications → Providers → OpenID Configuration Issuer.
# Redirect URI в Authentik: <BASE_URL>/login/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Пусто — публичный клиент с PKCE. С секретом — confidential client.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=Authentik
# Клейм с группами (в Authentik по умолчанию "groups" при включённом scope) и группы,
# дающие роль преподавателя.
OIDC_GROUPS_CLAIM=groups
OIDC_TEACHER_GROUPS=sp-teachers

# --- локальная разработка ---
# Включает вход по имени без Telegram на /login/dev. НИКОГДА не включай в проде.
DEV_LOGIN_ENABLED=false

# Загрузка исходников посылок скриптом (scripts/fetch_sources.py).
# Пусто — приём выключен. Генерировать так же, как SECRET_KEY.
INGEST_TOKEN=

# --- фоновые задачи ---
ENABLE_SCHEDULER=true
ENABLE_BOT=true
# Как часто синкер обходит аккаунты и через сколько аккаунт считается устаревшим.
SYNC_INTERVAL_SECONDS=600
SYNC_STALE_SECONDS=540
CATALOG_REFRESH_HOURS=24

# --- отображение ---
# Все даты в интерфейсе показываются в этой зоне (в базе всегда UTC).
DISPLAY_TIMEZONE=Europe/Moscow
# Где лежит sport.db. В контейнере переопределяется на /data.
DATA_DIR=./data

# --- тонкая настройка, трогать обычно не нужно ---
# Пауза между запросами к платформам. Codeforces просит не чаще 1 раза в 2 с.
# CODEFORCES_MIN_INTERVAL=2.1
# LEETCODE_MIN_INTERVAL=1.0
# HTTP_TIMEOUT=30
# Сколько живёт одноразовый код входа и сессионная кука (в секундах).
# LOGIN_CODE_TTL_SECONDS=600
# SESSION_TTL_SECONDS=2592000
# SESSION_COOKIE=sport_session
# LEETCODE_USER_AGENT=...
# Разрешить работу с дефолтным SECRET_KEY. Только для отладки.
# ALLOW_INSECURE_SECRET=false
